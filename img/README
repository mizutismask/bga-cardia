This directory contains all graphic files for your game:
 - jpg and png formats are recommended, gif is also accepted
 - do not use subdirectories
 - use the "CSS sprite" technique for faster loading
 - use a reasonable resolution for the web and compression

Typically, this directory should contain less than 10 files (beside
box graphics and publisher images), with no file larger than 4 Mb.

See: http://en.doc.boardgamearena.com/Game_art:_img_directory for more details.

montage `ls -v .` -tile 4 -geometry 220x342+0+0 deck1.jpg
montage `ls -v .` -tile 4 -geometry 342x220+0+0 locations.jpg
montage `ls -v .` -tile 2 -geometry 220x342+0+0 deckBacks.jpg

ESP
mogrify -path ./cropped -shave 24x24 -quality 100 \*.png
montage `ls -v .` -crop 24x24 -tile 4 -geometry 220x342+0+0 deck1_ESP.jpg
montage `ls -v .` -crop 24x24 -tile 4 -geometry 220x342+0+0 deck2_ESP.jpg
montage `ls -v .` -rotate -90 -tile 4 -geometry 342x220+0+0 locations_ESP.jpg

POR
mkdir -p Deck1/cropped Deck2/cropped sceneries/cropped
for dir in Deck1 Deck2 sceneries; do
  (
    cd "$dir"
    mogrify -path cropped -shave 12x12 -quality 100 *.png

    case "$dir" in
      Deck1)
        out=deck1_ESP.jpg
        geo=220x342+0+0
        rot=""
        ;;
      Deck2)
        out=deck2_ESP.jpg
        geo=220x342+0+0
        rot=""
        ;;
      sceneries)
        out=locations_ESP.jpg
        geo=342x220+0+0
        rot="-rotate -90"
        ;;
    esac

    montage `ls -v cropped/*.png` $rot -tile 4 -geometry "$geo" "$out"
  )
done

