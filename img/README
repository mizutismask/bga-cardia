ITA
mkdir -p Deck1/cropped Deck2/cropped sceneries/cropped
for dir in Deck1 Deck2 sceneries; do
  (
    cd "$dir"
    mogrify -path cropped -shave 30x55 -quality 100 *.png

    case "$dir" in
      Deck1)
        out=deck1_ITA.jpg
        geo=220x342+0+0
        rot=""
        ;;
      Deck2)
        out=deck2_ITA.jpg
        geo=220x342+0+0
        rot=""
        ;;
      sceneries)
        mogrify -path cropped -shave 50x30 -quality 100 *.png
        out=locations_ITA.jpg
        geo=342x220+0+0
        rot="-rotate -90"
        ;;
    esac

    montage `ls -v cropped/*.png` $rot -tile 4 -geometry "$geo" "$out"
  )
done

